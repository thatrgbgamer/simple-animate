{
  "name": "simple-animate",
  "productName": "Simple Animate",
  "version": "1.0.0",
  "description": "A simple 2D frame-by-frame animation studio with onion skinning, shapes and video export.",
  "author": {
    "name": "ThatRGBGamer",
    "email": "theodoretylerf@gmail.com"
  },
  "homepage": "https://thatrgb.website/",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
